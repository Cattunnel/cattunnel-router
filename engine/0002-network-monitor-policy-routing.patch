+// Source address the kernel would use towards the internet, "" if unroutable. Route lookup
+// goes through policy rules, unlike the monitor's view of table main: on Android default
+// routes live in per-network tables, table main has none, and the monitor reports
+// "not connected" on every address/route event (the client then waits for network forever).
+static std::string routed_source() {
+    auto probe = [](int family, const char *dst_ip) -> std::string {
+        int fd = socket(family, SOCK_DGRAM | SOCK_CLOEXEC, 0);
+        if (fd < 0) {
+            return "";
+        }
+        sockaddr_storage dst{};
+        socklen_t dst_len;
+        if (family == AF_INET) {
+            auto *d = reinterpret_cast<sockaddr_in *>(&dst);
+            d->sin_family = AF_INET;
+            d->sin_port = htons(53);
+            inet_pton(AF_INET, dst_ip, &d->sin_addr);
+            dst_len = sizeof(sockaddr_in);
+        } else {
+            auto *d = reinterpret_cast<sockaddr_in6 *>(&dst);
+            d->sin6_family = AF_INET6;
+            d->sin6_port = htons(53);
+            inet_pton(AF_INET6, dst_ip, &d->sin6_addr);
+            dst_len = sizeof(sockaddr_in6);
+        }
+        std::string result;
+        sockaddr_storage src{};
+        socklen_t src_len = sizeof(src);
+        char buf[INET6_ADDRSTRLEN]{};
+        if (connect(fd, reinterpret_cast<sockaddr *>(&dst), dst_len) == 0
+                && getsockname(fd, reinterpret_cast<sockaddr *>(&src), &src_len) == 0) {
+            const void *addr = family == AF_INET ? static_cast<const void *>(&reinterpret_cast<sockaddr_in *>(&src)->sin_addr)
+                                                 : static_cast<const void *>(&reinterpret_cast<sockaddr_in6 *>(&src)->sin6_addr);
+            if (inet_ntop(family, addr, buf, sizeof(buf)) != nullptr) {
+                result = buf;
+            }
+        }
+        close(fd);
+        return result;
+    };
+    std::string src = probe(AF_INET, "8.8.8.8");
+    return src.empty() ? probe(AF_INET6, "2001:4860:4860::8888") : src;
+}
+#endif // __linux__
