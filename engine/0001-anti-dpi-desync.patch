+static int desync_get_ttl(evutil_socket_t fd, bool v6, int *ttl) {
+    socklen_t size = sizeof(*ttl);
+    return v6 ? getsockopt(fd, IPPROTO_IPV6, IPV6_UNICAST_HOPS, (char *) ttl, &size)
+              : getsockopt(fd, IPPROTO_IP, IP_TTL, (char *) ttl, &size);
+}
+
+static int desync_set_ttl(evutil_socket_t fd, bool v6, int ttl) {
+    return v6 ? setsockopt(fd, IPPROTO_IPV6, IPV6_UNICAST_HOPS, (const char *) &ttl, sizeof(ttl))
+              : setsockopt(fd, IPPROTO_IP, IP_TTL, (const char *) &ttl, sizeof(ttl));
+}
+
+// Bytes the kernel hasn't sent yet, or -1 if it won't say. Android's
+// SELinux denies apps the SIOCOUTQNSD ioctl; TCP_INFO works there.
+static int desync_unsent(evutil_socket_t fd) {
+#ifdef __linux__
+    int unsent = 0;
+    if (ioctl(fd, SIOCOUTQNSD, &unsent) == 0) {
+        return unsent;
+    }
+#ifdef __ANDROID__
+    tcp_info info{};
+    socklen_t size = sizeof(info);
+    if (getsockopt(fd, IPPROTO_TCP, TCP_INFO, &info, &size) == 0
+            && static_cast<size_t>(size) >= offsetof(tcp_info, tcpi_notsent_bytes) + sizeof(info.tcpi_notsent_bytes)) {
+        return static_cast<int>(info.tcpi_notsent_bytes);
+    }
+#endif
+#else
+    (void) fd;
+#endif
+    return -1;
+}
