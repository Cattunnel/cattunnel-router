+// Random padding (the PADDED flag, RFC 9113 6.1) on the first frames of the session: the sizes of the
+// tunnel's first requests and data are what a filter can fingerprint, the TLS records only hide them
+// in part. Padding is part of the HTTP/2 protocol, any server must accept it.
+static ssize_t select_padding_callback(
+        nghttp2_session *, const nghttp2_frame *frame, size_t max_payloadlen, void *user_data) {
+    auto *session = (HttpSession *) user_data;
+    size_t length = frame->hd.length;
+    if (session->h2 == nullptr || session->h2->padded_frames >= session->params.padding_frames
+            || max_payloadlen <= length) {
+        return ssize_t(length);
+    }
+    ++session->h2->padded_frames;
+    uint8_t random = 0;
+    RAND_bytes(&random, 1);
+    // + 1 for the Pad Length field itself
+    return ssize_t(std::min(max_payloadlen, length + 1 + random));
