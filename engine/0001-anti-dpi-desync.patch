diff --git a/net/test/test_desync_plan.cpp b/net/test/test_desync_plan.cpp
new file mode 100644
index 00000000..8f877133
--- /dev/null
+++ b/net/test/test_desync_plan.cpp
@@ -0,0 +1,40 @@
+#include <gtest/gtest.h>
+
+#include "net/tcp_socket.h"
+
+using namespace ag;
+
+TEST(DesyncPlan, ParsesByedpiParts) {
+    std::string error;
+    std::optional plan = desync_plan_parse("  -o1+s -d3+h\t-s-5 ", &error);
+    ASSERT_TRUE(plan.has_value()) << error;
+    ASSERT_EQ(plan->n_parts, 3);
+    EXPECT_EQ(plan->parts[0].how, DesyncPart::OOB);
+    EXPECT_TRUE(plan->parts[0].from_sni);
+    EXPECT_EQ(plan->parts[0].offset, 1);
+    EXPECT_EQ(plan->parts[1].how, DesyncPart::TTL1);
+    EXPECT_TRUE(plan->parts[1].from_sni);
+    EXPECT_EQ(plan->parts[2].how, DesyncPart::SPLIT);
+    EXPECT_FALSE(plan->parts[2].from_sni);
+    EXPECT_EQ(plan->parts[2].offset, -5);
+}
+
+TEST(DesyncPlan, EmptyIsEmpty) {
+    std::optional plan = desync_plan_parse("   ", nullptr);
+    ASSERT_TRUE(plan.has_value());
+    EXPECT_EQ(plan->n_parts, 0);
+}
+
+TEST(DesyncPlan, Rejects) {
+    for (const char *text : {"-r1+s", "-o3", "-o3 -s7", "-d", "-x3", "-d3+e", "-d1501", "d3", "-d3 -d4 -d5 -d6 -d7 -d8 -d9 -d10 -d11"}) {
+        std::string error;
+        EXPECT_FALSE(desync_plan_parse(text, &error).has_value()) << text;
+        EXPECT_FALSE(error.empty()) << text;
+    }
+}
+
+TEST(DesyncPlan, OobNeedsTtl1After) {
+    EXPECT_TRUE(desync_plan_parse("-o3 -d7", nullptr).has_value());
+    EXPECT_TRUE(desync_plan_parse("-o1 -s2 -d7 -s9", nullptr).has_value());
+    EXPECT_FALSE(desync_plan_parse("-d2 -o5", nullptr).has_value());
+}
