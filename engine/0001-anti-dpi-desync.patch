+// Waits (at most ~20 ms) until the kernel has sent what was queued, so that
+// restoring the TTL doesn't catch the TTL-1 part still in the queue: the
+// TTL is read when a packet actually goes out, and the kernel may hold a
+// small segment back while the previous one is still in the driver (TCP
+// small queues - seen on a Galaxy S22).
+static void desync_wait_sent(evutil_socket_t fd) {
+    for (int i = 0; i < 20; ++i) {
+        int unsent = desync_unsent(fd);
+        if (unsent == 0) {
+            return;
+        }
+        if (unsent < 0) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(10)); // can't tell: give it time
+            return;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
