+// Anti-DPI techniques for the first TLS ClientHello, after byedpi
+// (github.com/hufrea/byedpi, MIT, Copyright (c) 2024 hufrea): the ClientHello
+// stays one TLS record - the server's TLS stack never sees a difference - but
+// a middlebox reading the TCP stream gets it cut up or out of order.
+//  - OOB: `send(MSG_OOB)` of a prefix plus one junk byte; the junk byte is
+//    urgent data, which the receiving kernel takes out of the stream.
+//  - TTL 1: a prefix goes out with TTL/hop limit 1 and dies on the first
+//    hop; the kernel retransmits it later with the normal TTL, so the
+//    middlebox sees the rest of the stream first.
+
+// Offset of the SNI host name in a TLS record carrying a ClientHello.
+static std::optional<size_t> clienthello_sni_offset(const uint8_t *data, size_t len) {
+    auto u16 = [&](size_t at) {
+        return static_cast<size_t>((data[at] << 8) | data[at + 1]);
+    };
+    // record header (5) + handshake header (4) + version (2) + random (32)
+    size_t pos = 5 + 4 + 2 + 32;
+    if (len < pos + 1 || data[0] != 0x16 || data[5] != 0x01) {
+        return std::nullopt;
+    }
+    pos += 1 + data[pos]; // session id
+    if (len < pos + 2) {
+        return std::nullopt;
+    }
+    pos += 2 + u16(pos); // cipher suites
+    if (len < pos + 1) {
+        return std::nullopt;
+    }
+    pos += 1 + data[pos]; // compression methods
+    if (len < pos + 2) {
+        return std::nullopt;
+    }
+    size_t end = std::min(len, pos + 2 + u16(pos));
+    pos += 2;
+    while (pos + 4 <= end) {
+        size_t type = u16(pos);
+        size_t ext_len = u16(pos + 2);
+        pos += 4;
+        // server_name: list length (2), name type (1), name length (2), name
+        if (type == 0 && pos + 5 <= end && data[pos + 2] == 0) {
+            return pos + 5;
+        }
+        pos += ext_len;
+    }
+    return std::nullopt;
+}
