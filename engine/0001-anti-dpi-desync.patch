+}
+
+std::optional<DesyncPlan> desync_plan_parse(std::string_view text, std::string *error) {
+    auto fail = [error](std::string message) -> std::optional<DesyncPlan> {
+        if (error != nullptr) {
+            *error = std::move(message);
+        }
+        return std::nullopt;
+    };
+    DesyncPlan plan{};
+    bool oob_pending = false; // an `-o` with no `-d` after it yet
+    size_t pos = 0;
+    while (pos < text.size()) {
+        if (text[pos] == ' ' || text[pos] == '\t') {
+            ++pos;
+            continue;
+        }
+        size_t end = text.find_first_of(" \t", pos);
+        std::string_view token = text.substr(pos, end == std::string_view::npos ? std::string_view::npos : end - pos);
+        pos += token.size();
+
+        if (token.size() < 3 || token[0] != '-') {
+            return fail(fmt::format("\"{}\": expected -s, -o or -d with a position", token));
+        }
+        DesyncPart part{};
+        switch (token[1]) {
+        case 's':
+            part.how = DesyncPart::SPLIT;
+            break;
+        case 'o':
+            part.how = DesyncPart::OOB;
+            break;
+        case 'd':
+            part.how = DesyncPart::TTL1;
+            break;
+        case 'r':
+            return fail(fmt::format("\"{}\": TLS record split is not supported by the server", token));
+        default:
+            return fail(fmt::format("\"{}\": unknown option, only -s, -o and -d", token));
+        }
+        std::string_view rest = token.substr(2);
+        bool negative = !rest.empty() && rest[0] == '-';
+        if (negative) {
+            rest.remove_prefix(1);
+        }
+        int value = 0;
+        size_t digits = 0;
+        while (digits < rest.size() && rest[digits] >= '0' && rest[digits] <= '9' && value <= 9999) {
+            value = value * 10 + (rest[digits++] - '0');
+        }
+        if (digits == 0 || value > 1500) {
+            return fail(fmt::format("\"{}\": position must be a number from -1500 to 1500", token));
+        }
+        rest.remove_prefix(digits);
+        if (rest == "+s" || rest == "+h") {
+            part.from_sni = true;
+        } else if (!rest.empty()) {
+            return fail(fmt::format("\"{}\": only +s or +h may follow the position", token));
+        }
+        part.offset = static_cast<int16_t>(negative ? -value : value);
+        if (plan.n_parts == DesyncPlan::MAX_PARTS) {
+            return fail(fmt::format("at most {} parts", DesyncPlan::MAX_PARTS));
+        }
+        plan.parts[plan.n_parts++] = part;
+        if (part.how == DesyncPart::OOB) {
+            oob_pending = true;
+        } else if (part.how == DesyncPart::TTL1) {
+            oob_pending = false;
+        }
+    }
+    if (oob_pending) {
+        return fail("every -o needs a -d after it, or the server stalls");
+    }
+    return plan;
+}
