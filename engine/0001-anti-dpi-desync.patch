+#ifdef __linux__
+    for (int i = 0; i < 500; ++i) {
+        tcp_info info{};
+        socklen_t size = sizeof(info);
+        if (getsockopt(fd, IPPROTO_TCP, TCP_INFO, &info, &size) != 0 || info.tcpi_unacked == 0) {
+            return;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+#else
+    (void) fd;
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+#endif
+}
+
+static DesyncPlan desync_plan_for(const DesyncPlan &custom, uint8_t mode) {
+    if (custom.n_parts != 0) {
+        return custom;
+    }
+    // Mode 1: OOB alone (byedpi -o1) hangs a tokio server such as TrustTunnel's:
+    // its read stops at the urgent mark, the short read makes tokio treat the
+    // socket as drained, and the rest of the ClientHello, already queued, never
+    // wakes it. The TTL-1 part is retransmitted later, and that arrival does.
+    static const char *const BUILT_IN[] = {nullptr, "-o3 -d7", "-d7", "-o1+s -d3+s"};
+    DesyncPlan plan{};
+    if (mode < std::size(BUILT_IN) && BUILT_IN[mode] != nullptr) {
+        plan = *desync_plan_parse(BUILT_IN[mode], nullptr);
+    }
+    return plan;
+}
