+/// Why the connections to an endpoint failed, as far as the client can tell; a larger value is more
+/// specific and wins when several connections failed differently.
+enum PingFailure : uint8_t {
+    PING_FAILURE_NONE,
+    PING_FAILURE_CONNECT,          // no TCP connection (refused, unreachable, timed out), or QUIC failed
+    PING_FAILURE_HELLO_RESET,      // TCP connected, the ClientHello went out, the connection was reset or closed
+    PING_FAILURE_HELLO_NO_ANSWER,  // TCP connected, the ClientHello went out, nothing came back in time:
+                                   // what a filter "freezing" the address looks like
+};
+
+/// Short stable name of a `PingFailure` for error texts and logs.
+constexpr const char *ping_failure_name(PingFailure failure) {
+    switch (failure) {
+    case PING_FAILURE_CONNECT:
+        return "connect";
+    case PING_FAILURE_HELLO_RESET:
+        return "hello_reset";
+    case PING_FAILURE_HELLO_NO_ANSWER:
+        return "hello_no_answer";
+    case PING_FAILURE_NONE:
+        break;
+    }
+    return "none";
+}
